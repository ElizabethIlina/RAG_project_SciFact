# GigaChat: copy this file to .env and fill in the credentials.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL="GigaChat-2"
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=false

# Langfuse is wired in a later experiment stage. Keep secrets local.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"

# Local retrieval services
QDRANT_URL=
ELASTICSEARCH_URL=

# Reproducibility
RAG_RANDOM_SEED=42
RAG_DATA_DIR=data